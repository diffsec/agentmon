<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>dev.diffsec.agentmon.SysExt</string>
	<key>CFBundleIdentifier</key>
	<string>dev.diffsec.agentmon.SysExt</string>
	<key>CFBundleName</key>
	<string>AgentMon System Extension</string>
	<key>CFBundlePackageType</key>
	<string>SYSX</string>
	<!-- Build number, substituted from CURRENT_PROJECT_VERSION at build time.
	     It must increase on every release: macOS replaces an installed system
	     extension only when the new one carries a higher version, and this was
	     hardcoded to 1.0.0 with nothing anywhere setting it. Verified the
	     consequence directly -- installing a rebuilt bundle left the previous
	     extension running, with the new one staged in /Library/SystemExtensions
	     and never swapped in. Shipped as-is, users would keep the first
	     extension they ever installed and receive no fixes to it. -->
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Claiming the networkextension entitlement makes sysextd run the
	     NetworkExtension category validator on activation, and that validator
	     rejects the extension outright if this key is absent or empty:
	     "The value of the NetworkExtension key must be a non-empty dictionary."
	     A failed category validation uninstalls the WHOLE extension, taking
	     Endpoint Security down with it -- endpoint_security validated fine and
	     the extension was removed anyway. Entitlement and Info.plist must move
	     together.

	     The class names are module-qualified because these are Swift classes
	     with no @objc(name); the module is PRODUCT_NAME with dots replaced,
	     i.e. dev_diffsec_agentmon_SysExt. -->
	<key>NetworkExtension</key>
	<dict>
		<key>NEProviderClasses</key>
		<dict>
			<key>com.apple.networkextension.filter-data</key>
			<string>dev_diffsec_agentmon_SysExt.FilterDataProvider</string>
			<key>com.apple.networkextension.dns-proxy</key>
			<string>dev_diffsec_agentmon_SysExt.DNSProxyProvider</string>
		</dict>
	</dict>
	<key>NSEndpointSecurityMachServiceName</key>
	<string>dev.diffsec.agentmon.SysExt</string>
	<key>NSSystemExtensionUsageDescription</key>
	<string>AgentMon uses a system extension to monitor file access, network connections, and process execution for policy enforcement.</string>
</dict>
</plist>
