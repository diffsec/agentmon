cask "agentmon" do
  version "__VERSION__"
  sha256 "__SHA256__"

  url "https://github.com/diffsec/agentmon/releases/download/v#{version}/AgentMon-v#{version}.dmg"
  name "AgentMon"
  desc "Secure sandboxed shell for AI agents"
  homepage "https://github.com/diffsec/agentmon"

  depends_on macos: ">= :sonoma"

  app "AgentMon.app"

  binary "#{appdir}/AgentMon.app/Contents/MacOS/agentmon"
  binary "#{appdir}/AgentMon.app/Contents/MacOS/agentmon-shell-shim"
  binary "#{appdir}/AgentMon.app/Contents/MacOS/agentmon-stub"
  binary "#{appdir}/AgentMon.app/Contents/MacOS/agentmon-macwrap"

  uninstall quit:      "dev.diffsec.agentmon",
            signal:    ["TERM", "agentmon"],
            launchctl: "dev.diffsec.agentmon.daemon"

  zap trash: [
    "~/Library/Application Support/agentmon",
    "~/Library/Preferences/dev.diffsec.agentmon.plist",
    "~/Library/Caches/dev.diffsec.agentmon",
    "~/Library/LaunchAgents/dev.diffsec.agentmon.daemon.plist",
  ]

  postflight do
    system "#{appdir}/AgentMon.app/Contents/MacOS/agentmon", "activate-extension"
  end

  caveats <<~EOS
    After installation you will be prompted to approve the AgentMon system extension.
    Go to System Settings -> General -> Login Items & Extensions to allow it.
  EOS
end
